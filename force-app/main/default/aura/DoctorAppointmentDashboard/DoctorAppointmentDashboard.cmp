<aura:component controller="DoctorAppointmentDashboardApex" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:availableForFlowScreens" access="global">
    <aura:attribute name="selectedLookUpRecord" type="sObject" default="{}"/>
    <aura:attribute name="objContact" type="contact" default="{'sobjectType':'contact'}"/>
    <aura:attribute name="allData" type="Object" />
    <aura:attribute name="filteredData" type="List" />
    <aura:attribute name="tableData" type="List" />
    <aura:attribute name="columns" type="Object[]" />
    <aura:attribute name="pageSize" type="Integer" default="2" />
    <aura:attribute name="pageSizeOptions" type="Integer[]" default="2,4,6" />
    <aura:attribute name="currentPageNumber" type="Integer" default="1" />
    <aura:attribute name="totalPages" type="Integer" default="1" />
    <aura:attribute name="searchPhrase" type="String" />
    <aura:attribute name="AppStatus" type="String" />
    <aura:attribute name="isLoading" type="Boolean" default="false" />
    <aura:attribute name="ShowTimeField" type="Boolean" default="false" />
    <aura:attribute name="Homepopup" type="Boolean" default="true"/>
    <aura:attribute name="FlowPopup" type="Boolean" default="false" />
    <aura:attribute name="isLoadingBack" type="Boolean" default="false" />
    <aura:attribute name="checkValue" type="String" default="true"/>
    <aura:handler name="init" value="{!this }" action="{! c.doInit }" />
    <aura:handler name="oSelectedRecordEventPass" event="c:DoctorDashboard" action="{!c.handleComponentEventPass}"/>
    <aura:attribute name="contactId" type="String" />
    <aura:attribute name="AppointmentId" type="Map" />
    <aura:attribute name="AppointmentStatus" type="Map" />
    <aura:attribute name="showmyspinner" type="Boolean" default="false" />
    <aura:attribute name="ButtonShow" type="boolean" default="false"/>
    <aura:attribute name="showCancelBox" type="boolean" default="false"/>
    <aura:attribute name="ShowToast" type="boolean" default="true"/>
    <aura:attribute name="ShowTable" type="boolean" default="false"/>
    <aura:attribute name="showNoAppointment" type="boolean" default="false"/>
    <aura:attribute name="showtabledata" type="boolean" default="false"/>
    <aura:attribute name="selectedLeads" type="List"/>
    <aura:attribute name="DateTime" type="DateTime"/>
    <aura:attribute name="activeTabId" type="String" default="badge"/>
    <aura:attribute name="doctorResolved" type="Boolean" default="false"/>
    <aura:attribute name="doctorName" type="String"/>
    <aura:attribute name="doctorEmail" type="String"/>
    <aura:attribute name="doctorAuthenticated" type="Boolean" default="false"/>
    <aura:attribute name="doctorOtpCode" type="String"/>
    <aura:attribute name="doctorOtpInput" type="String"/>
    <aura:attribute name="doctorOtpSent" type="Boolean" default="false"/>
    <aura:attribute name="doctorLoginEmail" type="String"/>
    <aura:attribute name="showClinicalUpdateModal" type="Boolean" default="false"/>
    <aura:attribute name="selectedAppointmentId" type="String"/>
    <aura:attribute name="selectedAppointmentNumber" type="String"/>
    <aura:attribute name="selectedPatientName" type="String"/>
    <aura:attribute name="clinicalEncounterType" type="String"/>
    <aura:attribute name="clinicalEncounterSummary" type="String"/>
    <aura:attribute name="clinicalAllergyName" type="String"/>
    <aura:attribute name="clinicalAllergySeverity" type="String" default="Moderate"/>
    <aura:attribute name="clinicalConditionName" type="String"/>
    <aura:attribute name="clinicalConditionSeverity" type="String" default="Moderate"/>
    <aura:attribute name="clinicalMedicationName" type="String"/>
    <aura:attribute name="clinicalImmunizationName" type="String"/>
    <aura:attribute name="clinicalImmunizationDate" type="Date"/>
    <aura:attribute name="clinicalProcedureName" type="String"/>
    <aura:attribute name="clinicalCarePlanSubject" type="String"/>
    <aura:attribute name="clinicalCarePlanNotes" type="String"/>
    <ltng:require scripts="{!$Resource.jsOTP}" afterScriptsLoaded="{!c.afterLoad}" />
    
    <aura:if isTrue="{!v.Homepopup}">
        <div class="dashboardShell">
        <lightning:card class="dashboardShellCard">
            
            <aura:if isTrue="{!v.showmyspinner}">
                <div class="outerBox spinner">
                    <lightning:spinner aura:id="mySpinner" variant="brand" size="medium" class='slds=hide'/>
                </div>
            </aura:if>
            <div class="dashboardHero fontsize">
                <div class="dashboardHeroInner">
                    <p class="dashboardEyebrow">Doctor workspace</p>
                    <h1><b>{!$Label.c.Practitioner_Appointment_DashBoard}</b></h1>
                    <p class="dashboardSubtitle">Review appointments, update clinical notes, and close visits with a clean production workflow.</p>
                </div>
            </div>
            <div class="dashboardIntroCard slds-m-around_large">
                <aura:if isTrue="{!v.doctorResolved}">
                    <div class="slds-align_absolute-center">
                        <h3><b>Signed in as {!v.doctorName}</b></h3>
                    </div>
                    <div class="slds-align_absolute-center slds-m-top_small">
                        <aura:if isTrue="{!not(v.doctorAuthenticated)}">
                            <p>Verify OTP sent to {!v.doctorEmail} to access only your appointments.</p>
                            <aura:set attribute="else">
                                <p>Only your appointments are visible in this dashboard.</p>
                            </aura:set>
                        </aura:if>
                    </div>
                    <div class="slds-align_absolute-center slds-m-top_medium">
                        <aura:if isTrue="{!and(v.doctorResolved, not(v.doctorAuthenticated))}">
                            <aura:if isTrue="{!v.doctorOtpSent}">
                                <div class="dashboardAuthPanel">
                                    <lightning:input type="text" label="Enter OTP" value="{!v.doctorOtpInput}" maxlength="6"/>
                                    <div class="slds-m-top_medium slds-align_absolute-center">
                                        <lightning:button variant="neutral" label="Resend OTP" onclick="{!c.sendDoctorOtp}" class="slds-m-right_small"/>
                                        <lightning:button variant="brand" label="Verify OTP" onclick="{!c.verifyDoctorOtp}"/>
                                    </div>
                                </div>
                                <aura:set attribute="else">
                                    <lightning:button variant="brand" label="Send OTP" onclick="{!c.sendDoctorOtp}"/>
                                </aura:set>
                            </aura:if>
                        </aura:if>
                    </div>
                    <aura:set attribute="else">
                        <div class="slds-align_absolute-center">
                            <h3><b>Doctor login required</b></h3>
                        </div>
                        <div class="slds-align_absolute-center slds-m-top_small">
                            <p>Enter your registered doctor email to receive OTP.</p>
                        </div>
                        <div class="slds-align_absolute-center slds-m-top_medium">
                            <div class="dashboardAuthPanel">
                                <lightning:input type="email" label="Doctor Email" value="{!v.doctorLoginEmail}"/>
                                <div class="slds-m-top_medium slds-align_absolute-center">
                                    <lightning:button variant="brand" label="Send OTP" onclick="{!c.lookupDoctorByEmail}"/>
                                </div>
                            </div>
                        </div>
                    </aura:set>
                </aura:if>
                <br/> 
            </div>
            <lightning:card class="dashboardTableShell">                               
                <aura:if isTrue="{!v.ShowToast}">
                    <div class="slds-align_absolute-center dashboardInfoBanner" > 
                        <h5><b>Verify doctor OTP to open your appointment dashboard.</b></h5>
                    </div>
                </aura:if>
                <aura:if isTrue="{!and(v.ShowTable, v.doctorAuthenticated)}">
                    <div class="slds-grid slds-p-top_low dashboardFilterBar">
                        <aura:if isTrue="{!v.ShowTimeField}">
                            <div class="slds-size_3-of-10 slds-p-left_xx-small slds-p-horizontal_x-large dashboardFilterControl" >
                                <lightning:select
                                                  label="{!$Label.c.Number_of_records_on_page}"
                                                  value="{!v.pageSize }"
                                                  onchange="{!c.onPageSizeChange }">
                                    <aura:iteration items="{!v.pageSizeOptions}" var="opt">
                                        <option text="{!opt }"></option>
                                    </aura:iteration>
                                </lightning:select>
                            </div>
                            <div class="slds-size_3-of-10 slds-p-left_xx-small slds-p-horizontal_x-large dashboardFilterControl" >
                                <lightning:input type="date" name="input1" label="{!$Label.c.Enter_a_date}" aura:id="DateChange" onchange="{!c.onPageDateChange}"/>
                            </div>
                        </aura:if>
                        <aura:if isTrue="{!v.ButtonShow}">
                            <div class="buttonLeft dashboardActionSlot">
                                <lightning:button variant="brand" label="Cancel Appointment" title="Brand action" onclick="{!c.handleConfirmDialog }" class="dashboardPrimaryButton slds-m-bottom_large"/>
                            </div>
                        </aura:if>
                    </div>    
                    <br/>
                    <lightning:tabset variant="scoped" selectedTabId="{!v.activeTabId}" class="dashboardTabset">
                        <lightning:tab onactive="{! c.handleActive }" label="{!$Label.c.Scheduled_Appointments}" id="badge">
                            <div class="dashboardTablePanel">
                            <aura:if isTrue="{!v.showtabledata}">
                            <lightning:datatable
                                                 aura:id="table"
                                                 columns="{! v.columns }"
                                                 data="{!v.allData}"
                                                 hideCheckboxColumn="false"
                                                 keyField="Id" 
                                                 showRowNumberColumn="true"
                                                 onrowselection="{! c.updateSelectedText}"
                                                 onrowaction="{! c.handleAction }"/>
                             <aura:set attribute="else">
                                  <center class="dashboardEmptyState">
                                      ...NO SCHEDULED APPOINTMENTS FOUND...
                                 </center>
                                     </aura:set>
                            </aura:if>
                            </div>
                            
                        </lightning:tab>
                        
                        <lightning:tab onactive="{! c.handlecancel }" label="{!$Label.c.Canceled_Appointments}" id="cancel">
                            <div class="dashboardTablePanel">
                            <aura:if isTrue="{!v.showtabledata}">
                            <lightning:datatable
                                                 aura:id="table"
                                                 columns="{! v.columns }"
                                                 data="{!v.allData}"
                                                 hideCheckboxColumn="false"
                                                 keyField="Id" 
                                                 showRowNumberColumn="true"
                                  onrowselection="{! c.updateSelectedText}"
                                                 onrowaction="{! c.handleAction }"/>
                                  <aura:set attribute="else">
                                  <center class="dashboardEmptyState">
                                      ...NO CANCELED APPOINTMENTS FOUND...
                                 </center>
                                     </aura:set>
                            </aura:if>
                            </div>
                        </lightning:tab>
                        
                        <lightning:tab onactive="{! c.handlecompleted }" label="{!$Label.c.Completed_Appointments}" id="complete">
                            <div class="dashboardTablePanel">
                            <aura:if isTrue="{!v.showtabledata}">
                            <lightning:datatable
                                                 aura:id="table"
                                                 columns="{! v.columns }"
                                                 data="{!v.allData}"
                                                 hideCheckboxColumn="false"
                                                 keyField="Id" 
                                                 showRowNumberColumn="true"
                                                 onrowselection="{! c.updateSelectedText}"
                                                 onrowaction="{! c.handleAction }"/>
                            <aura:set attribute="else">
                                  <center class="dashboardEmptyState">
                                      ...NO COMPLETED APPOINTMENTS FOUND...
                                 </center>
                                     </aura:set>
                            </aura:if>
                            </div>
                        </lightning:tab>
                    </lightning:tabset>
                    <br/>
                    <div class="slds-align_absolute-center">
                        <lightning:button
                                          label="Previous"
                                          iconName="utility:chevronleft"
                                          iconPosition="left"
                                          onclick="{! c.onPrev }"
                                          variant="brand-outline"
                                          disabled="{! v.currentPageNumber == 1 }" />
                        <span class="slds-var-p-horizontal_x-small">
                            Page {! (v.currentPageNumber) } of {! (v.totalPages) }
                        </span>
                        <lightning:button
                                          label="Next"
                                          iconName="utility:chevronright"
                                          iconPosition="right"
                                          onclick="{! c.onNext }"
                                          variant="brand-outline"
                                          disabled="{! v.currentPageNumber == v.totalPages }" />
                    </div>
                </aura:if>
            </lightning:card>
        </lightning:card>
        </div>
    </aura:if>
    
    <aura:if isTrue="{!v.FlowPopup}">
        <lightning:card>
            <center>
                <lightning:flow aura:id="flowData"/>
            </center>
        </lightning:card>
    </aura:if>
    
    <aura:if isTrue="{!v.showCancelBox}">
        <div role="dialog" class="slds-modal slds-fade-in-open ">
            <div class="slds-modal__container">
                <header class="slds-modal__header">
                    <h1 class="slds-text-heading--medium">Confirmation to Cancel Appointment?</h1>
                </header>
                <div class="slds-modal__content slds-p-around--medium">
                    <center><b>Are You Sure Want To Cancel The Appointments</b></center>
                </div>
                <footer class="slds-modal__footer">
                    <lightning:button name='No' label='No' onclick='{!c.handleConfirmDialogCancel}'/>
                    <lightning:button variant="brand" name='Yes,Sure' label='Yes,Sure' onclick='{!c.handleClickCancel}'/>
                </footer>
            </div>
        </div>
        <div class="slds-backdrop slds-backdrop--open"></div> 
    </aura:if>
    
    <aura:if isTrue="{!v.showNoAppointment}">
                <div class="headingForNoAppointment slds-align_absolute-center">
                <h6><b> ..... Sorry You Dont Have Any Appointment Yet .....</b></h6>
              </div>
                                                 
    </aura:if>

    <aura:if isTrue="{!v.showClinicalUpdateModal}">
        <section role="dialog" class="slds-modal slds-fade-in-open">
            <div class="slds-modal__container">
                <header class="slds-modal__header">
                    <h2 class="slds-text-heading_medium">Clinical Update</h2>
                    <p class="slds-m-top_x-small">Appointment {!v.selectedAppointmentNumber} for {!v.selectedPatientName}</p>
                </header>
                <div class="slds-modal__content slds-p-around_medium">
                    <lightning:layout multipleRows="true">
                        <lightning:layoutItem size="12" mediumDeviceSize="6" padding="around-small">
                            <lightning:input label="Encounter Type" value="{!v.clinicalEncounterType}"/>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="12" mediumDeviceSize="6" padding="around-small">
                            <lightning:input label="Medication" value="{!v.clinicalMedicationName}"/>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="12" padding="around-small">
                            <lightning:textarea label="Encounter Summary / Impression" value="{!v.clinicalEncounterSummary}"/>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="12" mediumDeviceSize="6" padding="around-small">
                            <lightning:input label="Allergy" value="{!v.clinicalAllergyName}"/>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="12" mediumDeviceSize="6" padding="around-small">
                            <lightning:select label="Allergy Severity" value="{!v.clinicalAllergySeverity}">
                                <option value="Mild">Mild</option>
                                <option value="Moderate">Moderate</option>
                                <option value="Severe">Severe</option>
                                <option value="High">High</option>
                            </lightning:select>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="12" mediumDeviceSize="6" padding="around-small">
                            <lightning:input label="Health Condition" value="{!v.clinicalConditionName}"/>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="12" mediumDeviceSize="6" padding="around-small">
                            <lightning:select label="Condition Severity" value="{!v.clinicalConditionSeverity}">
                                <option value="Mild">Mild</option>
                                <option value="Moderate">Moderate</option>
                                <option value="Severe">Severe</option>
                                <option value="High">High</option>
                            </lightning:select>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="12" mediumDeviceSize="6" padding="around-small">
                            <lightning:input label="Immunization" value="{!v.clinicalImmunizationName}"/>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="12" mediumDeviceSize="6" padding="around-small">
                            <lightning:input type="date" label="Immunization Date" value="{!v.clinicalImmunizationDate}"/>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="12" padding="around-small">
                            <lightning:input label="Medical Procedure" value="{!v.clinicalProcedureName}"/>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="12" padding="around-small">
                            <lightning:input label="Care Plan Subject" value="{!v.clinicalCarePlanSubject}"/>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="12" padding="around-small">
                            <lightning:textarea label="Care Plan Notes" value="{!v.clinicalCarePlanNotes}"/>
                        </lightning:layoutItem>
                    </lightning:layout>
                </div>
                <footer class="slds-modal__footer">
                    <lightning:button label="Cancel" onclick="{!c.closeClinicalUpdateModal}" />
                    <lightning:button variant="brand" label="Save Clinical Update" onclick="{!c.submitClinicalUpdate}" class="slds-m-left_small"/>
                </footer>
            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open"></div>
    </aura:if>
    
</aura:component>
